# changes the biome of the current block, and also the biomes for all 4 blocks above it.
fillbiome ~ ~ ~ ~ ~4 ~ crimson_forest replace #biome-spread:crimson_overworld
fillbiome ~ ~ ~ ~ ~4 ~ warped_forest replace #biome-spread:warped_overworld
fillbiome ~ ~ ~ ~ ~4 ~ basalt_deltas replace #biome-spread:basalt_overworld
fillbiome ~ ~ ~ ~ ~4 ~ nether_wastes replace #biome-spread:replaceable